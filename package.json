{
  "name": "kata-mars-rover",
  "version": "1.0.0",
  "private": true,
  "description": "Kata Mars Rover en TypeScript con Bun, ESLint, Prettier y Jest",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "bun run clean && tsc -b tsconfig.build.json",
    "clean": "rm -rf lib coverage",
    "analyze": "bun run lint:fix && bun run compile",
    "compile": "tsc --noEmit",
    "compile:watch": "tsc --noEmit --watch",
    "compile:build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "lint-staged:debug": "lint-staged --debug",
    "format": "prettier . --check",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "validate": "bun run compile && bun run lint && bun run test",
    "upgrade": "ncu -i",
    "upgrade:all": "ncu -u"
  },
  "author": "jmvelasco",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@jest/globals": "30.2.0",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "lint-staged": "16.2.7",
    "npm-check-updates": "19.1.2",
    "prettier": "3.7.4",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}
